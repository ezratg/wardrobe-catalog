# Copy this file to .env.local and fill in what you need.

# Auto-tagging runs free on this machine by default. Set AUTO_TAG=off to disable it.
# AUTO_TAG=off

# Optional, paid: use Claude for tagging instead (more descriptive names + style tags).
# Get a key at https://console.anthropic.com; usage is billed to that account.
ANTHROPIC_API_KEY=

# Optional: the model used for tagging (default claude-opus-5-5).
# AUTO_TAG_MODEL=claude-haiku-5-5

# Optional: where the database and photos are stored (default ./data).
# DATA_DIR=./data
